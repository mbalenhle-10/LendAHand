<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- HEADER                                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2F3E46"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <!-- BACK + TITLE ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#33FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/back_arrow">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_arrow"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_need_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp"
                android:fontFamily="serif"/>
        </LinearLayout>

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_need_subtitle"
            android:textSize="13sp"
            android:textColor="#CDE3EA"
            android:layout_marginTop="6dp"
            android:layout_marginStart="60dp"/>

        <!-- STEP PROGRESS BARS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#99FFFFFF"
                android:layout_marginEnd="6dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#8A6F5A"
                android:layout_marginEnd="6dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CATEGORY TABS — horizontal scroll, populated from API       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2F3E46"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/categoryTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SCROLLABLE CONTENT                                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ITEM"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5A524A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <!-- ITEM PANELS — populated dynamically from API -->
            <LinearLayout
                android:id="@+id/itemGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2DDD8"
                android:layout_marginBottom="20dp"/>

            <!-- ─── QUANTITY ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTITY NEEDED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5A524A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/minus"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2F3E46"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/qty_decrease"/>

                <TextView
                    android:id="@+id/tvQtyDisplay"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/two"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#2F3E46"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@string/plus_symbol"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2F3E46"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/qty_increase"/>
            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2DDD8"
                android:layout_marginBottom="20dp"/>

            <!-- ─── NOTE ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADDITIONAL NOTE (OPTIONAL)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#5A524A"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:hint="@string/note_hint"
                android:textColorHint="#8A8A8A"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:inputType="textMultiLine"
                android:autofillHints="no"
                android:layout_marginBottom="20dp"/>

            <!-- SUBMIT -->
            <LinearLayout
                android:id="@+id/btnSubmitNeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#2F3E46"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit_need"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>