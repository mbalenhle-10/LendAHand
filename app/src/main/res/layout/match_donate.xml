<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1EA">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2F3E46"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#33FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_arrow"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/match_donate_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginStart="12dp"
                android:fontFamily="serif"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_donate_subtitle"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#CDE3EA"
            android:layout_marginTop="6dp"
            android:layout_marginStart="48dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="20dp">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#99FFFFFF"
                android:layout_marginEnd="6dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#8A6F5A"
                android:layout_marginEnd="6dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#33FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- RESOURCE GRID -->
            <include layout="@layout/section_resource_grid"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2DDD8"
                android:layout_marginBottom="20dp"/>

            <!-- ALLOCATION PROGRESS -->
            <include layout="@layout/section_alloc_progress"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2DDD8"
                android:layout_marginBottom="20dp"/>

            <!-- PEOPLE WHO NEED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/people_who_need"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8A7F78"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nearby_count"
                    android:textSize="11sp"
                    android:textColor="#8A7F78"
                    android:background="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"/>
            </LinearLayout>

            <!-- RECIPIENT CARDS -->
            <include layout="@layout/card_recepient_1"/>
            <include layout="@layout/card_recepient_2"/>
            <include layout="@layout/card_recepient_3"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2DDD8"
                android:layout_marginBottom="20dp"/>

            <!-- NOTE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/additional_note"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8A7F78"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etDonationNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:hint="@string/donation_note_hint"
                android:textColorHint="#B0A99F"
                android:textSize="14sp"
                android:textColor="#2B2B2B"
                android:inputType="textMultiLine"
                android:autofillHints="no"
                android:layout_marginBottom="20dp"/>

            <!-- CONFIRM BUTTON -->
            <LinearLayout
                android:id="@+id/btnConfirmAllocations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#2F3E46"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_allocations"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>